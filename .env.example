# ── PostgreSQL ────────────────────────────────────────────────────────────────
# asyncpg driver requires the postgresql+asyncpg:// scheme
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+asyncpg://user:pass@host:port/gemfinder

# ── Cloudflare R2 ────────────────────────────────────────────────────────────
# R2_ACCOUNT_ID : found in the R2 dashboard (right sidebar on the overview page)
# R2_PUBLIC_URL : enable "Public access" on the bucket → copy the r2.dev URL,
#                 or set a custom domain and use that instead
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_REGION=auto

# ── Segurança ─────────────────────────────────────────────────────────────────
# Gere uma chave forte: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=sua_chave_secreta_aqui
